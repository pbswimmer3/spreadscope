[Unit]
Description=SpreadScope Ingestion Workers
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=spreadscope
WorkingDirectory=/opt/spreadscope
ExecStart=/opt/spreadscope/venv/bin/python run_ingestion.py --config /opt/spreadscope/config/config.yaml
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spreadscope-ingestion

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/spreadscope/logs

[Install]
WantedBy=multi-user.target